---
/**
 * 读 content/algorithms/<slug>/level.json，按四步和块的类型挂控件。
 * 页面结构和文案在内容目录里，规则在 src/engine，画面在 src/ui/vue/scenes，这里不认识任何具体算法。
 */
import AlgoLayout from '../../layouts/AlgoLayout.astro';
import Block from './shared/Block.astro';
import CodePanel from './shared/CodePanel.vue';
import LogCompare from './shared/LogCompare.astro';
import { t } from '../../core/i18n';
import type { Msg } from '../../core/types';
import { loadLevel } from '../levelData';
import BlockView from './BlockView.astro';
import { COPY_ELEMENT_ID } from './i18n';

interface Props { slug: string; title: string; lede: string }
const { slug } = Astro.props;
const { level, copy, engine, html } = await loadLevel(slug);

const COMPARE = '<!-- compare -->';
/** 正文里单独一行 <!-- code:名字 -->，换成一块 Kotlin 代码（代码行在引擎导出的 moreCode[名字]） */
const CODE_MARK = /^<!-- code:(\w+) -->$/;
const MARKS = /(<!-- compare -->|<!-- code:\w+ -->)/;

/** 把 more.zh.md 渲染出的 HTML 按「## 」切成块：标题第一个字符是图标，正文里的 <!-- compare --> 单独成段 */
function sections(src: string) {
  // 站内链接在 Markdown 里写 @base/algo/xxx/，这里换成带站点前缀的真实地址
  return html[src]
    .replaceAll('href="@base/', 'href="' + import.meta.env.BASE_URL)
    .split(/<h2[^>]*>/)
    .slice(1)
    .map((part) => {
      const [head, ...rest] = part.split('</h2>');
      // 标题第一个字（按字形算，🛠️ 这类带变体选择符的图标不能拆开）是图标
      const text = head.replace(/<[^>]+>/g, '').trim();
      const icon = [...new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(text)][0]?.segment ?? '';
      const body = rest.join('</h2>');
      // 切成文字段和标记（compare、code:名字）交替的一列；标记本身留着，渲染时认
      return { icon, title: text.slice(icon.length).trim(), segs: body.split(MARKS).filter((s) => s.trim()) };
    });
}

/** 对比图的数据由引擎给，文字是 Msg，这里按文案表填好 */
function compareRows() {
  const rows = (engine.compareRows as (() => { label: string; unit: Msg; bars: { name: Msg; value: number; tone: 'muted' | 'accent' | 'warn' }[] }[]) | undefined)?.();
  if (!rows) throw new Error('src/engine/' + slug + '.ts 没有导出 compareRows，但 more.zh.md 里用了 ' + COMPARE);
  return rows.map((r) => ({ ...r, unit: t(r.unit, copy), bars: r.bars.map((b) => ({ ...b, name: t(b.name, copy) })) }));
}

/** 延伸里嵌的代码由引擎的 moreCode 给 */
function codeLines(name: string): string[] {
  const lines = (engine.moreCode as Record<string, string[]> | undefined)?.[name];
  if (!lines) throw new Error('src/engine/' + slug + '.ts 的 moreCode 里没有 ' + name + '，但 more.zh.md 里用了 <!-- code:' + name + ' -->');
  return lines;
}

const more = (level.more ?? []).flatMap((b) => (b.kind === 'markdown' ? sections(b.src) : []));
---

<AlgoLayout {...Astro.props}>
  <script is:inline slot="data" type="application/json" id={COPY_ELEMENT_ID} set:html={JSON.stringify(copy).replace(/</g, '\\u003c')} />
  {level.look && (
    <Fragment slot="look">
      {level.look.map((block) => block.kind !== 'markdown' && <BlockView slug={slug} block={block} copy={copy} />)}
    </Fragment>
  )}
  {level.play && (
    <Fragment slot="play">
      {level.play.map((block) => block.kind !== 'markdown' && <BlockView slug={slug} block={block} copy={copy} />)}
    </Fragment>
  )}
  {level.do && (
    <Fragment slot="do">
      {level.do.map((block) => block.kind !== 'markdown' && <BlockView slug={slug} block={block} copy={copy} />)}
    </Fragment>
  )}
  {level.more && (
    <Fragment slot="more">
      {more.map((sec) => (
        <Block icon={sec.icon} title={sec.title}>
          <div class="md">
            {sec.segs.map((seg) => (seg === COMPARE ? <LogCompare rows={compareRows()} /> : CODE_MARK.test(seg) ? <CodePanel lines={codeLines(seg.match(CODE_MARK)![1])} active={0} lang="KOTLIN" /> : <Fragment set:html={seg} />))}
          </div>
        </Block>
      ))}
    </Fragment>
  )}
</AlgoLayout>

<style is:global>
  /* 文案和 Markdown 渲染出来的正文：段落、列表、行内代码沿用原来各关写的样子 */
  .md { display: flex; flex-direction: column; gap: 16px; }
  .md p:not(.small-note) { max-width: 36em; }
  .md ul { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 8px; max-width: 44em; }
  .md code { font: 500 0.9em var(--mono); background: var(--out); padding: 1px 6px; border-radius: 4px; }
</style>
