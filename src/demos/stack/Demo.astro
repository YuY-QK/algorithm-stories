---
import AlgoLayout from '../../layouts/AlgoLayout.astro';
import LogCompare from '../../components/shared/LogCompare.astro';
import Block from '../../components/shared/Block.astro';
import LookStory from './LookStory.vue';
import PlayPlates from './PlayPlates.vue';
import PlayBlocks from './PlayBlocks.vue';
import DoTrace from './DoTrace.vue';
import DoPredict from './DoPredict.vue';
import DoBug from './DoBug.vue';
import DoChallenge from './DoChallenge.vue';

interface Props { slug: string; title: string; lede: string }

const repo = 'https://github.com/YuY-QK/algorithm-stories/tree/main/exercises';

// 最坏情况：((((…)))) 一层套一层。用栈扫一遍是 n 步；
// 「反复删掉相邻的一对」每轮只删掉最里面一对，却要把剩下的串从头看一遍，约 n²/4 步。
const rows = [10, 100, 1000, 10000].map((n) => ({
  label: n.toLocaleString('en-US'),
  unit: '个括号',
  bars: [
    { name: '反复删', value: (n * n) / 4, tone: 'muted' as const, approx: true },
    { name: '用栈', value: n, tone: 'accent' as const },
  ],
}));
---

<AlgoLayout {...Astro.props}>
  <Fragment slot="look">
    <Block icon="📖" title="盘子的故事">
      <LookStory client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="play">
    <Block icon="🍽️" title="拿盘子">
      <PlayPlates client:only="vue" />
    </Block>

    <Block icon="🧩" title="拼积木">
      <PlayBlocks client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="do">
    <Block icon="①" title="先看一遍" intro="用栈判断括号有没有全部配对：左括号入栈，右括号必须和栈顶是同一种，最后栈要空。每一步对应下面 Kotlin 代码的一行，高亮行是正在执行的那一行。">
      <DoTrace client:only="vue" />
    </Block>

    <Block icon="②" title="猜下一步" intro="每个字符先猜代码会怎么做：入栈、弹出配对，还是 return false；扫完再猜返回值。连对 8 次过关。">
      <DoPredict client:only="vue" />
    </Block>

    <Block icon="③" title="找 bug" intro="括号配对最常见的三个坑。每段代码只错了一行：先播放，看它怎么跑错，再点出错的那一行。">
      <DoBug client:only="vue" />
    </Block>

    <Block icon="④" title="亲手写">
      <p class="story">在自己电脑上用 IntelliJ IDEA 或 Android Studio 打开仓库里的 <a href={repo}><code class="path">exercises/</code></a> 目录，把 <code class="path">stack/Stack.kt</code> 里的 <code class="path">TODO()</code> 换成你的代码：</p>
      <ul class="pits">
        <li><code>IntStack</code>：用 <code>IntArray</code> 加一个 <code>size</code> 自己做一个栈，<code>push</code>、<code>pop</code>、<code>peek</code>，满了自动扩容。</li>
        <li><code>isValid(s)</code>：三种括号的配对，就是上面演示的那段代码，试着不看它写出来。</li>
        <li><code>evalRPN(tokens)</code>：逆波兰表达式求值，比如 <code>2 1 + 3 *</code> 等于 9。数字入栈，遇到运算符弹出两个数算完再入栈。</li>
      </ul>
      <p class="story">写完在 <code class="path">exercises/</code> 目录运行下面的命令，测试全绿就过关：</p>
      <div class="code"><div class="codehead">TERMINAL</div><pre><div class="line"><i>$</i><span>./gradlew test --tests 'stack.*'</span></div></pre></div>
    </Block>

    <Block icon="⑤" title="挑战">
      <DoChallenge client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="more">
    <Block icon="⚡" title="为什么快">
      <p class="story">放、拿、看栈顶，都只碰最上面那一个，不管栈里有多少东西都是一步，时间 O(1)。用数组实现时，满了换一个两倍大的数组，偶尔要拷贝一次，平均下来每次 push 仍是 O(1)。</p>
      <p class="story">所以括号配对只要从头到尾扫一遍。不用栈的笨办法是反复删掉相邻的一对 <code class="path">()</code>，遇到一层套一层的串，每轮只能删掉最里面一对，却要把整串再看一遍：</p>
      <LogCompare rows={rows} />
      <p class="small-note">条形长度用对数刻度绘制。数字是最坏情况下大约要看的字符数。</p>
    </Block>

    <Block icon="🧠" title="为什么非用栈不可" intro="只有一种括号时，数一数「还有几个左括号没配上」就够了，一个计数器搞定。有三种括号时，右括号要和「最近一个还没配上的左括号」比种类，这个「最近一个」正是栈顶。" />

    <Block icon="🌍" title="真实世界里的栈">
      <ul class="pits">
        <li>函数调用栈：每调用一个函数，就压进一个栈帧（参数、局部变量、返回地址），函数返回时弹出。递归太深把栈用完，Kotlin 和 Java 里就抛 <code>StackOverflowError</code>。</li>
        <li>JVM 字节码是基于栈的：<code>iadd</code> 这样的指令从操作数栈弹出两个数，把和压回去。</li>
        <li>编辑器的撤销和重做：每次修改压进撤销栈；撤销时弹出来，压进重做栈。</li>
        <li>浏览器的后退和前进，可以看成两个栈。</li>
        <li>表达式求值：Dijkstra 的调度场算法用栈把 <code>(2 + 1) * 3</code> 变成逆波兰式 <code>2 1 + 3 *</code>，再用栈算出结果。</li>
        <li>深度优先搜索：走迷宫时把岔路口压进栈，走进死胡同就弹出，回到最近的岔路口。</li>
      </ul>
    </Block>

    <Block icon="🛠️" title="Kotlin 里怎么用">
      <p class="story">直接用标准库的 <code class="path">ArrayDeque</code>：<code class="path">addLast</code> 入栈，<code class="path">removeLast</code> 出栈，<code class="path">last()</code> 看栈顶，栈可能空时用 <code class="path">removeLastOrNull()</code>。Java 的老类 <code class="path">java.util.Stack</code> 继承自 <code class="path">Vector</code>，官方文档建议改用 <code class="path">Deque</code>。</p>
    </Block>

    <Block icon="🔀" title="常见变种">
      <ul class="pits">
        <li>最小栈：再配一个栈记录「到目前为止的最小值」，随时 O(1) 拿到最小值（LeetCode 155）。</li>
        <li>单调栈：栈里保持递增或递减，用来找「右边第一个比我大的数」、柱状图里最大的矩形。</li>
        <li>用两个栈做一个队列：一个只进、一个只出，倒一次顺序就反过来了。</li>
      </ul>
    </Block>
  </Fragment>
</AlgoLayout>

<style>
  .path { font: 500 0.9em var(--mono); background: var(--out); padding: 1px 6px; border-radius: 4px; }
</style>
