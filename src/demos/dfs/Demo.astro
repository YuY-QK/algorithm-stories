---
import AlgoLayout from '../../layouts/AlgoLayout.astro';
import Block from '../../components/shared/Block.astro';
import LookStory from './LookStory.vue';
import PlayExplore from './PlayExplore.vue';
import PlayIslands from './PlayIslands.vue';
import DoTrace from './DoTrace.vue';
import DoPredict from './DoPredict.vue';
import DoBug from './DoBug.vue';
import DoChallenge from './DoChallenge.vue';

interface Props { slug: string }

const repo = 'https://github.com/YuY-QK/algorithm-stories/tree/main/exercises';
---

<AlgoLayout {...Astro.props}>
  <Fragment slot="look">
    <Block icon="📖" title="探险家走山洞" intro="一页一页翻，看探险家怎么一路走到底、没路了再退回来。">
      <LookStory client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="play">
    <Block icon="🧭" title="下一步往哪走">
      <PlayExplore client:only="vue" />
    </Block>

    <Block icon="🏝️" title="数一数小岛">
      <PlayIslands client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="do">
    <Block icon="①" title="先看一遍" intro="在山洞里判断 S 能不能走到 E。每一步对应右边 Kotlin 代码的一行，高亮行是正在执行的那一行。注意调用栈：每进一个格子多一层，死路 return 就少一层。">
      <DoTrace client:only="vue" />
    </Block>

    <Block icon="②" title="猜下一步" intro="动画会停在探险家刚站稳的时候。先猜接下来是往前走（去哪格）、回溯（退到哪个路口），还是已经到了宝藏，连对几次过关。">
      <DoPredict client:only="vue" />
    </Block>

    <Block icon="③" title="找 bug" intro="写 DFS 最常见的三个坑。每段代码只错了一行：先播放，看它怎么跑错，再点出错的那一行。">
      <DoBug client:only="vue" />
    </Block>

    <Block icon="④" title="亲手写">
      <p class="story">在自己电脑上用 IntelliJ IDEA 或 Android Studio 打开仓库里的 <a href={repo}><code class="path">exercises/</code></a> 目录，把 <code class="path">Dfs.kt</code> 里的三个 <code class="path">TODO()</code> 换成你的代码：</p>
      <ul class="pits">
        <li><code>numIslands(grid)</code>：数岛屿（'1' 陆地、'0' 海），上下左右连着的陆地算一座。洪水填充：点到一块没访问的陆地就数一座，再用 DFS 把整座岛标记掉。</li>
        <li><code>hasPath(grid)</code>：山洞里 S 能不能走到 E。</li>
        <li><code>countPaths(grid)</code>：S 到 E 一共有几条不重复走格子的路。这是回溯：进格子时标记，退出时要把标记擦掉。</li>
      </ul>
      <p class="story">写完在 <code class="path">exercises/</code> 目录运行下面的命令，测试全绿就过关：</p>
      <div class="code"><div class="codehead">TERMINAL</div><pre><div class="line"><i>$</i><span>./gradlew test --tests 'dfs.*'</span></div></pre></div>
    </Block>

    <Block icon="⑤" title="挑战">
      <DoChallenge client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="more">
    <Block icon="⏱️" title="复杂度" intro="每个格子最多被标记一次，每个格子看四个方向，时间是 O(h·w)；一般的图是 O(V + E)。空间是 visited 加上调用栈，最坏一条路穿过所有格子，递归深度就是 O(h·w)。">
    </Block>

    <Block icon="📚" title="递归深度和 StackOverflowError">
      <ul class="pits">
        <li>递归写法每进一个格子就叠一层调用栈。JVM 默认的栈大约能撑上万层，1000×1000 的空地可能一条路走一百万格，会 StackOverflowError。</li>
        <li>办法：改成显式的栈（<code>ArrayDeque</code> 当栈用），数据放在堆里，不怕深；或者在更大栈的线程里跑。</li>
        <li>显式栈要小心：想要和递归一样的访问顺序，得记住每个格子试到第几个方向（本关「看」里的行程就是这样算出来的）。</li>
      </ul>
    </Block>

    <Block icon="⚖️" title="DFS 和 BFS 怎么选">
      <ul class="pits">
        <li>要「最少步数」「最短路」用 BFS；DFS 第一次到达的路不一定最短（「看」里的第一个山洞：DFS 走 13 步，最短只要 11 步）。</li>
        <li>只问「能不能走到」「有几块连在一起」「有没有环」「排顺序」，DFS 代码更短。</li>
        <li>内存：BFS 要装下最宽的一圈，DFS 只装当前这条路；很宽很浅的图 DFS 省内存，很深的图 BFS 省栈。</li>
        <li>把 BFS 的队列换成栈，BFS 就变成 DFS。</li>
      </ul>
    </Block>

    <Block icon="🌍" title="真实世界里的 DFS">
      <ul class="pits">
        <li>洪水填充：画图软件的「油漆桶」把一块颜色相同、连在一起的区域涂成新颜色，本关「数岛」就是它。</li>
        <li>拓扑排序：按依赖关系排顺序（先装哪个包、先编译哪个模块），DFS 的「退出时间」倒过来就是一种拓扑序。</li>
        <li>检测环：DFS 时碰到「还在栈上」的点，说明有环；构建系统用它发现循环依赖。</li>
        <li>迷宫生成：随机 DFS 挖通道，就是「挖一条路走到底，没路了退回换方向」。</li>
        <li>回溯搜索：数独、八皇后、排列组合，试一步、往下递归、不行就撤销，本质是带撤销的 DFS。</li>
        <li>强连通分量（Tarjan、Kosaraju）、连通分量、二分图判断等图算法的基础。</li>
      </ul>
    </Block>
  </Fragment>
</AlgoLayout>

<style>
  .path { font: 500 0.9em var(--mono); background: var(--out); padding: 1px 6px; border-radius: 4px; }
</style>
