---
import AlgoLayout from '../../layouts/AlgoLayout.astro';
import LogCompare from '../../components/shared/LogCompare.astro';
import Block from '../../components/shared/Block.astro';
import { compareBounds } from '../../engine/merge-sort';
import LookStory from './LookStory.vue';
import PlayMerge from './PlayMerge.vue';
import PlaySplit from './PlaySplit.vue';
import DoTrace from './DoTrace.vue';
import DoPredict from './DoPredict.vue';
import DoBug from './DoBug.vue';
import DoChallenge from './DoChallenge.vue';

interface Props { slug: string; title: string; lede: string }

const repo = 'https://github.com/YuY-QK/algorithm-stories/tree/main/exercises';

// 比较次数：归并取最坏情况（精确值），插入排序随机打乱约 n²/4，选择排序固定 n(n − 1)/2
const rows = [
  { label: '10', unit: '一手牌', n: 10 },
  { label: '1,000', unit: '一千', n: 1000 },
  { label: '100,000', unit: '十万', n: 100000 },
  { label: '1,000,000', unit: '一百万', n: 1000000 },
].map((r) => ({
  label: r.label,
  unit: r.unit,
  bars: [
    { name: '归并', value: compareBounds(r.n).max, tone: 'accent' as const },
    { name: '插入', value: (r.n * r.n) / 4, tone: 'muted' as const, approx: true },
    { name: '选择', value: (r.n * (r.n - 1)) / 2, tone: 'warn' as const },
  ],
}));
---

<AlgoLayout {...Astro.props}>
  <Fragment slot="look">
    <Block icon="📖" title="分开再合并" intro="一页一页翻，看一大队人怎么对半分开，再两队两队合并成整齐的一队。">
      <LookStory client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="play">
    <Block icon="🔀" title="合并两队">
      <PlayMerge client:only="vue" />
    </Block>

    <Block icon="✂️" title="拆一拆">
      <PlaySplit client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="do">
    <Block icon="①" title="先看一遍">
      <p class="story">先把区间对半分，递归排好左半和右半，再用临时数组 <code class="path">tmp</code> 把两半合并，最后抄回去。注意看调用栈怎么长出来、又怎么缩回去。每一步对应下面 Kotlin 代码的一行。</p>
      <DoTrace client:only="vue" />
    </Block>

    <Block icon="②" title="猜下一步">
      <p class="story">两种题：合并时下一个放进 <code class="path">tmp</code> 的来自左边还是右边，以及递归下一个处理哪个区间。连对 6 次过关。</p>
      <DoPredict client:only="vue" />
    </Block>

    <Block icon="③" title="找 bug" intro="写归并排序最常见的三个坑。每段代码只错了一行：先播放，看它怎么跑错，再点出错的那一行。">
      <DoBug client:only="vue" />
    </Block>

    <Block icon="④" title="亲手写">
      <p class="story">在自己电脑上用 IntelliJ IDEA 或 Android Studio 打开仓库里的 <a href={repo}><code class="path">exercises/</code></a> 目录，把 <code class="path">mergesort/MergeSort.kt</code> 里的三个 <code class="path">TODO()</code> 换成你的代码：</p>
      <ul class="pits">
        <li><code>merge(a, b)</code>：把两个已经排好的数组合成一个新的有序数组。这是整个算法的心脏。</li>
        <li><code>mergeSort(arr)</code>：对半分、递归、再调用 <code>merge</code>，返回排好的新数组，不改动原数组。</li>
        <li><code>countInversions(arr)</code>：变种。数一数有多少对「前面比后面大」。提示：合并时，右边的数先走，说明它比左边剩下的每一个都小。</li>
      </ul>
      <p class="story">写完在 <code class="path">exercises/</code> 目录运行下面的命令，测试全绿就过关：</p>
      <div class="code"><div class="codehead">TERMINAL</div><pre><div class="line"><i>$</i><span>./gradlew test --tests 'mergesort.*'</span></div></pre></div>
    </Block>

    <Block icon="⑤" title="挑战">
      <DoChallenge client:only="vue" />
    </Block>
  </Fragment>

  <Fragment slot="more">
    <Block icon="⚡" title="快还是慢，看数据">
      <p class="story">n 个数一共要分 log₂n 层，每一层的合并加起来最多比较 n 次，所以总共不超过 n log₂n 次。而且不管输入长什么样（有序、倒序、随机）都是这个量级：最坏也是 O(n log n)。插入和选择排序是 O(n²)，数据一多差距就大得惊人。</p>
      <LogCompare rows={rows} />
      <p class="small-note">数字是比较次数，条形长度用对数刻度绘制。归并取最坏情况的精确值，插入是随机打乱时约 n²/4，选择固定是 n(n − 1)/2。同样排一百万个数，差了一万到两万多倍。</p>
    </Block>

    <Block icon="🧷" title="稳定，但要额外的空间">
      <ul class="pits">
        <li><b>稳定</b>：两边队头相等时取左边的（<code>&lt;=</code>），相等的元素不会越过彼此。「找 bug」里的第一个坑就是写成了 <code>&lt;</code>。</li>
        <li><b>时间有保证</b>：最好、平均、最坏都是 O(n log n)，不像快速排序最坏会退化到 O(n²)。</li>
        <li><b>要额外的空间</b>：合并需要临时数组 <code>tmp</code>，额外空间 O(n)。这是它最大的代价；数组版很难做到原地合并。</li>
        <li><b>递归深度只有 log n</b>：每次对半分，栈很浅，不会溢出（除非像「找 bug」第三个坑那样，出口写错了）。</li>
      </ul>
    </Block>

    <Block icon="🌍" title="真实世界里的归并排序">
      <ul class="pits">
        <li><b>Java 对象排序</b>：<code>Arrays.sort(Object[])</code>、<code>List.sort</code> 用的 <code>TimSort</code>，是「稳定、自适应的归并排序」：先找出已经有序的片段（run），不够长的用二分插入排序补长，再像归并那样一段一段合并。Kotlin 在 JVM 上对 <code>List</code> 排序（<code>sorted()</code>、<code>sortedBy</code>）最终也走这里，所以是稳定的。基本类型数组 <code>IntArray.sort()</code> 则用双轴快排，不稳定也无所谓。</li>
        <li><b>Python</b>：<code>list.sort</code> 和 <code>sorted</code> 就是 Timsort，原作者是 Tim Peters。</li>
        <li><b>外部排序</b>：数据比内存大时，先把数据切成能装进内存的块，每块排好写到磁盘，再用多路归并把这些有序的块合成一个。数据库排序、大数据的 shuffle 阶段、命令行 <code>sort</code> 处理大文件，思路都是它。</li>
        <li><b>链表</b>：链表不能随机访问，快排不好用，归并排序只改指针、不需要额外数组，是链表排序的首选（LeetCode 148）。</li>
      </ul>
    </Block>

    <Block icon="🔧" title="常见变种">
      <ul class="pits">
        <li><b>自底向上</b>：不用递归，先把相邻两个合并，再把相邻两对合并……一层一层往上，就是「看」里倒着合并的那一章。</li>
        <li><b>数逆序对</b>：合并时右边的数先走，它就和左边剩下的每个数构成逆序对。顺手数一数，O(n log n) 就能得到逆序对数，而不是暴力的 O(n²)。「亲手写」的第三题。</li>
        <li><b>多路归并</b>：一次合并 k 个有序序列，每次从 k 个队头里挑最小的（用堆，LeetCode 23）。外部排序就是它。</li>
      </ul>
    </Block>
  </Fragment>
</AlgoLayout>

<style>
  .path { font: 500 0.9em var(--mono); background: var(--out); padding: 1px 6px; border-radius: 4px; }
</style>
