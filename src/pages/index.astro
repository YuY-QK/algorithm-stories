---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { STAGES } from '../content.config';
import { STAGE_ICON } from '../stages';
import { loadDict, translator } from '../i18n/load';
import { toHtml } from '../i18n/format';

const algos = (await getCollection('algorithms')).sort((a, b) => a.data.order - b.data.order);
// 按分类分组，分类的先后由组里最小的 order 决定
const groups = [...new Set(algos.map((a) => a.data.category))].map((c) => ({ name: c, items: algos.filter((a) => a.data.category === c) }));
const base = import.meta.env.BASE_URL;
const t = translator(loadDict());
/** 卡片上的文字在各关自己的语言文件里 */
const tt = (slug: string, key: string) => translator(loadDict(slug))(key);
---

<Base title={t('site.name')} nav="home">
  <header class="mast">
    <h1>{t('site.name')}</h1>
    <p class="lede">{t('home.lede')}</p>
  </header>

  <section class="panel">
    <h2>{t('home.stages')}</h2>
    <div class="tiers">
      {STAGES.map((l) => (
        <div class="tier"><b>{STAGE_ICON[l]} {t('stage.' + l + '.name')} · {t('stage.' + l + '.who')}</b><span>{t('stage.' + l + '.how')}</span></div>
      ))}
    </div>
  </section>

  {groups.map((g) => (
  <section class="panel">
    <h2>{t('category.' + g.name)}</h2>
    <div class="cards">
      {g.items.map((a) => (
        <a class="card" href={base + 'algo/' + a.id + '/'}>
          <span class="t">{tt(a.id, 'meta.title')}</span>
          <span class="s">{tt(a.id, 'meta.storyTitle')}：{tt(a.id, 'meta.summary')}</span>
          <span class="badges">
            {STAGES.map((l) => <span class={'badge' + (a.data.stages.includes(l) ? ' on' : '')}>{t('stage.' + l + '.name')}</span>)}
          </span>
        </a>
      ))}
    </div>
  </section>
  ))}

  <p class="small-note" set:html={toHtml(t('home.more'))} />
</Base>
