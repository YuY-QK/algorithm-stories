---
import { getCollection } from 'astro:content';
import { DEMOS } from '../../demos';
import { LEVELS } from '../../levels';
import LevelPage from '../../runtime/LevelPage.astro';

export async function getStaticPaths() {
  const all = await getCollection('algorithms');
  return all.map((a) => ({ params: { slug: a.id }, props: { algo: a } }));
}

const { algo } = Astro.props;
// 迁移期间：有 src/levels/<slug>/level.ts 的按配置生成，其余还用旧的 Demo.astro
const level = LEVELS[algo.id];
const Demo = DEMOS[algo.id];
if (!level && !Demo) throw new Error('content/algorithms/' + algo.id + ' 还没有 src/levels/' + algo.id + '/level.ts');
---

{level ? <LevelPage level={level} /> : Demo && <Demo slug={algo.id} />}
