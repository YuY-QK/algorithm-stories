---
import { getCollection } from 'astro:content';
import LevelPage from '../../ui/vue/LevelPage.astro';
import { hasLevel } from '../../ui/levelData';

export async function getStaticPaths() {
  const all = await getCollection('algorithms');
  return all.map((a) => ({ params: { slug: a.id }, props: { algo: a } }));
}

const { algo } = Astro.props;
// 每关的页面都由 content/algorithms/<slug>/level.json 组装
if (!hasLevel(algo.id)) throw new Error('content/algorithms/' + algo.id + ' 缺少 level.json');
---

<LevelPage slug={algo.id} title={algo.data.title} lede={algo.data.lede} />
