---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadDict, translator } from '../../i18n/load';

export async function getStaticPaths() {
  const all = await getCollection('stories');
  return all.map((s) => ({ params: { slug: s.id }, props: { story: s } }));
}

const { story } = Astro.props;
const meta = await getEntry('algorithms', story.id);
const { Content } = await render(story);
const base = import.meta.env.BASE_URL;
const t = translator(loadDict(story.id));
const title = meta ? t('stories.title', { title: t('meta.title'), storyTitle: t('meta.storyTitle') }) : story.id;
---

<Base title={title} description={meta ? t('meta.summary') : undefined} nav="stories" slug={story.id}>
  <article class="prose">
    <Content />
  </article>
  <a class="btn primary cta" href={base + 'algo/' + story.id + '/'}>{t('stories.cta', { title: meta ? t('meta.title') : '' })}</a>
</Base>
