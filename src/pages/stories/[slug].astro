---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('stories');
  return all.map((s) => ({ params: { slug: s.id }, props: { story: s } }));
}

const { story } = Astro.props;
const meta = await getEntry('algorithms', story.id);
const { Content } = await render(story);
const base = import.meta.env.BASE_URL;
const title = meta ? meta.data.title + '：' + meta.data.storyTitle : story.id;
---

<Base title={title} description={meta?.data.summary} nav="stories">
  <article class="prose">
    <Content />
  </article>
  <a class="btn primary cta" href={base + 'algo/' + story.id + '/'}>去玩一玩{meta ? meta.data.title : ''}演示</a>
</Base>
