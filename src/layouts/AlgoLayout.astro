---
/**
 * 算法关卡页：标题、步骤切换（看、玩、做、延伸）、各步骤的面板。
 * 每一步的内容通过同名插槽传入（<Fragment slot="play">…），没传的步骤不显示。
 */
import Base from './Base.astro';
import { STAGES } from '../content.config';
import { STAGE_INFO } from '../stages';

interface Props {
  slug: string;
  title: string;
  lede: string;
}
const { slug, title, lede } = Astro.props;
const base = import.meta.env.BASE_URL;

const stages = STAGES.filter((l) => Astro.slots.has(l));
const first = stages[0];
---

<Base title={title} description={lede}>
  <header class="mast">
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <div class="stages" role="tablist" aria-label="选择步骤">
      {stages.map((l, k) => (
        <button type="button" role="tab" id={'tab-' + l} data-stage={l} aria-selected={k === 0 ? 'true' : 'false'} aria-controls={'panel-' + l}>
          <i aria-hidden="true">{STAGE_INFO[l].icon}</i>{STAGE_INFO[l].name}<span>{STAGE_INFO[l].who}</span>
        </button>
      ))}
    </div>
  </header>

  <main>
    {/* 插槽名必须写死，Astro 才能保留里面的交互组件 */}
    {Astro.slots.has('look') && <section id="panel-look" class="panel" role="tabpanel" aria-labelledby="tab-look" hidden={first !== 'look'}><slot name="look" /></section>}
    {Astro.slots.has('play') && <section id="panel-play" class="panel" role="tabpanel" aria-labelledby="tab-play" hidden={first !== 'play'}><slot name="play" /></section>}
    {Astro.slots.has('do') && <section id="panel-do" class="panel" role="tabpanel" aria-labelledby="tab-do" hidden={first !== 'do'}><slot name="do" /></section>}
    {Astro.slots.has('more') && <section id="panel-more" class="panel" role="tabpanel" aria-labelledby="tab-more" hidden={first !== 'more'}><slot name="more" /></section>}
  </main>

  <p class="foot">
    想听完整的故事？读 <a href={base + 'stories/' + slug + '/'}>故事稿</a>。
    {stages.length < STAGES.length && <>目前有{stages.map((l) => STAGE_INFO[l].name).join('、')}，其他步骤正在制作中。</>}
  </p>
</Base>

<script>
  import { STAGE_CHANGE_EVENT } from '../components/shared/usePlayer';

  // 步骤切换：支持 ?stage=look|play|do|more 直接打开某一步
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-stage]')];
  function show(stage: string) {
    if (!tabs.some((t) => t.dataset.stage === stage)) return;
    for (const t of tabs) {
      const on = t.dataset.stage === stage;
      t.setAttribute('aria-selected', String(on));
      document.getElementById('panel-' + t.dataset.stage)!.hidden = !on;
    }
    window.dispatchEvent(new Event(STAGE_CHANGE_EVENT));
  }
  function go(stage: string) {
    show(stage);
    const url = new URL(location.href);
    url.searchParams.set('stage', stage);
    history.replaceState(null, '', url);
  }
  for (const t of tabs) t.addEventListener('click', () => go(t.dataset.stage!));
  // 面板里「下一步」之类的按钮：<button data-goto="play">
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-goto]');
    if (!b) return;
    go(b.dataset.goto!);
    document.querySelector('.mast')?.scrollIntoView({ behavior: 'smooth' });
  });
  const initial = new URLSearchParams(location.search).get('stage');
  if (initial) show(initial);
</script>
